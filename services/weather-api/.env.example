# SkyWeather Weather Server — copy to .env and fill in. Never commit real keys.
PORT=8080
# PostgreSQL (required). Docker: infra/docker-compose.yml → postgres://skyweather:skyweather_dev@127.0.0.1:5432/skyweather
# Without Docker: `npm run db:dev` prints a URL for an embedded PostgreSQL on port 54329.
DATABASE_URL=postgres://skyweather:skyweather_dev@127.0.0.1:54329/skyweather
DB_POOL_MAX=10
# Redis (optional in dev; required for more than one API/worker instance). Example: redis://127.0.0.1:6379
REDIS_URL=
INSTALLATION_TOKEN_TTL_DAYS=90
RATE_LIMIT_PER_MINUTE=120
GEONAMES_CACHE_DIR=./.geonames
# Comma-separated origins allowed by CORS (Flutter web dev server, etc.). Use * only in local dev.
CORS_ORIGINS=*
# Directory for the local JSON stores (locations, feedback). Not for production.
DATA_DIR=./data
# fixture | live. Fixture mode never calls paid/external providers.
PROVIDER_MODE=live
# Open-Meteo: free host is for development only. Production uses customer-api.open-meteo.com + key.
OPEN_METEO_FORECAST_HOST=https://api.open-meteo.com
OPEN_METEO_AQ_HOST=https://air-quality-api.open-meteo.com
OPEN_METEO_GEOCODING_HOST=https://geocoding-api.open-meteo.com
OPEN_METEO_API_KEY=
NOAA_SWPC_HOST=https://services.swpc.noaa.gov
PROVIDER_TIMEOUT_MS=3000
