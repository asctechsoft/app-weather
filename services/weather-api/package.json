{
  "name": "weather-api",
  "version": "0.1.0",
  "private": true,
  "description": "SkyWeather Weather Server (normalizes third-party weather data into the SkyWeather contract)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "npm run build && node dist/main.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate": "node dist/db/migrate.js",
    "db:dev": "npm run build && node dist/cli/dev-db.js",
    "import:geonames": "node dist/cli/import-geonames.js",
    "worker": "node dist/worker.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "adm-zip": "^0.5.16",
    "geo-tz": "^8.1.2",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@swc/core": "^1.9.3",
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/suncalc": "^1.9.2",
    "embedded-postgres": "^17.2.0-beta.15",
    "ioredis-mock": "^8.9.0",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
